# Copy this file to .env.local and paste in the two values from Supabase:
# Supabase > Project Settings > API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_paste_yours_here

# Signs rows in the shared lookup cache (database/update-lookup-cache.sql). Any long random string; use the same value in Vercel.
CACHE_SECRET=paste_a_long_random_string_here
